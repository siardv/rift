# admit maintained paths and file types; update for new directories and assets
*

# public repository metadata and documentation
!/.gitignore
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/project.yml
!/docs/
!/docs/privacy.md
!/docs/sdd.md

# open each parent before admitting its contents
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml

# native app sources
!/Rift/
!/Rift/*.swift
!/Rift/PrivacyInfo.xcprivacy
!/Rift/Components/
!/Rift/Components/*.swift
!/Rift/Screens/
!/Rift/Screens/*.swift
!/Rift/State/
!/Rift/State/*.swift
!/Rift/Support/
!/Rift/Support/*.swift

# maintained icon assets
!/Rift/Assets.xcassets/
!/Rift/Assets.xcassets/Contents.json
!/Rift/Assets.xcassets/AppIcon.appiconset/
!/Rift/Assets.xcassets/AppIcon.appiconset/Contents.json
!/Rift/Assets.xcassets/AppIcon.appiconset/AppIcon1024.png

# engine package sources
!/RiftEngine/
!/RiftEngine/Package.swift
!/RiftEngine/Sources/
!/RiftEngine/Sources/RiftEngine/
!/RiftEngine/Sources/RiftEngine/*.swift
!/RiftEngine/Sources/RiftEngine/Classify/
!/RiftEngine/Sources/RiftEngine/Classify/*.swift
!/RiftEngine/Sources/RiftEngine/Detect/
!/RiftEngine/Sources/RiftEngine/Detect/*.swift
!/RiftEngine/Sources/RiftEngine/Diff/
!/RiftEngine/Sources/RiftEngine/Diff/*.swift
!/RiftEngine/Sources/RiftEngine/Model/
!/RiftEngine/Sources/RiftEngine/Model/*.swift
!/RiftEngine/Sources/RiftEngine/Normalize/
!/RiftEngine/Sources/RiftEngine/Normalize/*.swift

# app and engine tests
!/RiftTests/
!/RiftTests/*.swift
!/RiftEngine/Tests/
!/RiftEngine/Tests/RiftEngineTests/
!/RiftEngine/Tests/RiftEngineTests/*.swift

# only maintained corpus cases; new cases need an explicit parent allowance
!/RiftEngine/Tests/RiftEngineTests/Corpus/
!/RiftEngine/Tests/RiftEngineTests/Corpus/README.md
!/RiftEngine/Tests/RiftEngineTests/Corpus/bidi_rename/
!/RiftEngine/Tests/RiftEngineTests/Corpus/blank_line_runs/
!/RiftEngine/Tests/RiftEngineTests/Corpus/bom_only/
!/RiftEngine/Tests/RiftEngineTests/Corpus/case_only/
!/RiftEngine/Tests/RiftEngineTests/Corpus/crlf_endings/
!/RiftEngine/Tests/RiftEngineTests/Corpus/emoji_modifier/
!/RiftEngine/Tests/RiftEngineTests/Corpus/empty_both/
!/RiftEngine/Tests/RiftEngineTests/Corpus/empty_vs_blank/
!/RiftEngine/Tests/RiftEngineTests/Corpus/eof_newline/
!/RiftEngine/Tests/RiftEngineTests/Corpus/identical/
!/RiftEngine/Tests/RiftEngineTests/Corpus/invisible_chars/
!/RiftEngine/Tests/RiftEngineTests/Corpus/json_pretty/
!/RiftEngine/Tests/RiftEngineTests/Corpus/minified/
!/RiftEngine/Tests/RiftEngineTests/Corpus/mixed/
!/RiftEngine/Tests/RiftEngineTests/Corpus/mostly_rewritten/
!/RiftEngine/Tests/RiftEngineTests/Corpus/nbsp_spaces/
!/RiftEngine/Tests/RiftEngineTests/Corpus/nfc_composition/
!/RiftEngine/Tests/RiftEngineTests/Corpus/one_side_empty/
!/RiftEngine/Tests/RiftEngineTests/Corpus/paragraph_split/
!/RiftEngine/Tests/RiftEngineTests/Corpus/python_sensitive/
!/RiftEngine/Tests/RiftEngineTests/Corpus/reflow_paragraph/
